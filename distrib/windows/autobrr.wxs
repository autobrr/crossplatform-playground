<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="{{.ProjectName}} {{.Version}}"
    UpgradeCode="7EE000B5-522A-4A47-B2BE-84E05734CFA8"
    Language="1033"
    Codepage="1252"
    Version="{{.Version}}"
    Manufacturer="autobrr"
    InstallerVersion="200"
    ProductCode="*">
    <SummaryInformation
      Keywords="Installer"
      Description="{{.ProjectName}} installer"
      Manufacturer="autobrr" />
    <Media
      Id="1"
      Cabinet="{{.ProjectName}}.cab"
      EmbedCab="yes"
    />
    <StandardDirectory Id='ProgramFiles{{ if eq .Arch "amd64" }}64{{ end }}Folder'>
      <Directory
        Id="{{.ProjectName}}"
        Name="{{.ProjectName}}">
        <Component
          Id="MainExecutable"
          Guid="F79D73A8-A984-4CDE-87C7-7AB5A35F695D">
          <File
            Id="{{.ProjectName}}.exe"
            Name="{{.Binary}}.exe"
            DiskId="1"
            Source="{{.Binary}}.exe"
            KeyPath="yes"
          >
            <Shortcut
              Id="{{.Binary}}.exe"
              Directory="ProgramMenuFolder"
              Name="{{.Binary}}"
              Target="[ProgramFilesFolder]\{{.Binary}}\{{.Binary}}.exe"
              WorkingDirectory='INSTALLDIR'
            />
          </File>
          <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="{{.ProjectName}}"
            Value=""
            Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature
      Id="Complete"
      Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>